@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">
    <!-- Filter Form -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-4">
                            <input type="text" class="form-control" name="searchTerm" value="@Model.TableModel.SearchTerm" 
                                placeholder="Search by class name or description...">
                        </div>
                        <div class="col-md-2">
                            <input type="number" class="form-control" name="minStudents" value="@Model.TableModel.MinStudents" 
                                placeholder="Min students">
                        </div>
                        <div class="col-md-2">
                            <input type="number" class="form-control" name="maxStudents" value="@Model.TableModel.MaxStudents" 
                                placeholder="Max students">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Filter</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header">
            <h5>Export Options</h5>
        </div>
        <div class="card-body">
            <form method="post" class="mb-3" id="exportForm">
                <input type="hidden" name="searchTerm" value="@Model.TableModel.SearchTerm" />
                <input type="hidden" name="minStudents" value="@Model.TableModel.MinStudents" />
                <input type="hidden" name="maxStudents" value="@Model.TableModel.MaxStudents" />
                <input type="hidden" name="pageNumber" value="@Model.TableModel.CurrentPage" />
                @foreach (var column in Model.AvailableColumns)
                {
                    <input type="hidden" name="SelectedColumns" id="column_@column" value="" disabled />
                }
                <div class="btn-group">
                    <button type="submit" asp-page-handler="ExportJson" class="btn btn-primary" title="Export all records">
                        Export All to JSON
                    </button>
                    <button type="submit" asp-page-handler="ExportJson" asp-route-exportFiltered="true" class="btn btn-secondary" title="Export current page">
                        Export Current Page to JSON
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row">
        <!-- Add/Edit Form -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@(Model.EditingId.HasValue ? "Edit Class" : "Add New Class")</h5>
                    <form method="post" asp-page-handler="Add">
                        <input type="hidden" asp-for="EditingId" />
                        <div class="mb-3">
                            <label asp-for="ClassInformationModel.ClassName" class="form-label">Class Name</label>
                            <input asp-for="ClassInformationModel.ClassName" class="form-control" />
                            <span asp-validation-for="ClassInformationModel.ClassName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ClassInformationModel.StudentCount" class="form-label">Student Count</label>
                            <input asp-for="ClassInformationModel.StudentCount" class="form-control" />
                            <span asp-validation-for="ClassInformationModel.StudentCount" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ClassInformationModel.Description" class="form-label">Description</label>
                            <textarea asp-for="ClassInformationModel.Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="ClassInformationModel.Description" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">@(Model.EditingId.HasValue ? "Update" : "Add")</button>
                            @if (Model.EditingId.HasValue)
                            {
                                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Class Table -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Class Information</h5>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    @foreach (var column in Model.AvailableColumns.Where(c => c != "Id"))
                                    {
                                        <th class="column-header" data-column="@column" style="cursor: pointer;">
                                            @column
                                            <span class="column-selected" style="display: none; color: #28a745;">✓</span>
                                        </th>
                                    }
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TableModel.Items)
                                {
                                    <tr>
                                        <td>@item.ClassName</td>
                                        <td>@item.StudentCount</td>
                                        <td>@item.Description</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-page-handler="Edit" asp-route-id="@item.Id" 
                                                   class="btn btn-warning btn-sm">Edit</a>
                                                <a asp-page-handler="Delete" 
                                                   asp-route-id="@item.Id"
                                                   asp-route-pageNumber="@Model.TableModel.CurrentPage"
                                                   asp-route-searchTerm="@Model.TableModel.SearchTerm"
                                                   asp-route-minStudents="@Model.TableModel.MinStudents"
                                                   asp-route-maxStudents="@Model.TableModel.MaxStudents"
                                                   class="btn btn-danger btn-sm" 
                                                   onclick="return confirm('Are you sure you want to delete this class?')">
                                                    Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (Model.TableModel.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @if (Model.TableModel.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?pageNumber=@(Model.TableModel.CurrentPage - 1)&searchTerm=@Model.TableModel.SearchTerm&minStudents=@Model.TableModel.MinStudents&maxStudents=@Model.TableModel.MaxStudents">Previous</a>
                                    </li>
                                }

                                @for (int i = 1; i <= Model.TableModel.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.TableModel.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?pageNumber=@i&searchTerm=@Model.TableModel.SearchTerm&minStudents=@Model.TableModel.MinStudents&maxStudents=@Model.TableModel.MaxStudents">@i</a>
                                    </li>
                                }

                                @if (Model.TableModel.CurrentPage < Model.TableModel.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?pageNumber=@(Model.TableModel.CurrentPage + 1)&searchTerm=@Model.TableModel.SearchTerm&minStudents=@Model.TableModel.MinStudents&maxStudents=@Model.TableModel.MaxStudents">Next</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.column-header').forEach(header => {
            header.addEventListener('click', () => {
                const column = header.dataset.column;
                const input = document.getElementById(`column_${column}`);
                const checkmark = header.querySelector('.column-selected');
                
                if (input.disabled) {
                    input.disabled = false;
                    input.value = column;
                    checkmark.style.display = 'inline';
                    header.style.backgroundColor = '#e8f5e9';
                } else {
                    input.disabled = true;
                    input.value = '';
                    checkmark.style.display = 'none';
                    header.style.backgroundColor = '';
                }
            });
        });

        // Auto-submit filter form when any filter value changes
        document.querySelectorAll('form[method="get"] input').forEach(input => {
            input.addEventListener('change', () => {
                input.form.submit();
            });
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
